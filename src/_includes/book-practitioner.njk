<section class="hero" style="background-image: url('/images/hero-book.jpg');">
</section>

{% include "breadcrumbs.njk" %}

<section class="section">
  <div class="container text-center">
    <h1>Book with {{ member.firstName }}</h1>
    <p style="max-width: 720px; margin: 16px auto 0; font-size: 1.05rem;">
      Book an appointment online with {{ member.name }}, {{ member.role | plain }} at Meridian Osteopathy in Hillmorton.{% if not member.noAcc and not member.cannotLodgeAcc %} ACC-registered — accident-related injuries are subsidised.{% endif %}
    </p>
    <ul style="max-width: 720px; margin: 16px auto 0; text-align: left; padding-left: 24px;">
      <li>Choose your service and time slot in the booking widget below.</li>
      <li>You'll receive an email confirmation immediately after booking.</li>
      {% if not member.noAcc %}{% if member.cannotLodgeAcc %}<li>If your visit relates to an injury covered by ACC, please bring your existing claim number — {{ member.firstName }} can treat you under your active claim. If you don't have a claim number yet, please book one of our osteopaths first.</li>{% else %}<li>If your visit relates to an injury covered by ACC, please bring your claim number if you have one. If you don't have one yet, just mention the injury when you arrive — you can still book and be treated.</li>{% endif %}{% endif %}
    </ul>
    <div style="max-width: 800px; margin: 32px auto 0;">
      <iframe id='cliniko-25867357' src='https://meridian-osteopathy.au2.cliniko.com/bookings?practitioner_id={{ member.bookingPractitionerId }}&embedded=true' frameborder='0' scrolling='auto' width='100%' height='1000' style='pointer-events: auto;'></iframe>
      <script src="/js/cliniko-booking.js"></script>
    </div>
    <p style="max-width: 720px; margin: 32px auto 0; font-size: .95rem;">
      <a href="/book/">&larr; Book with a different practitioner</a>
    </p>
  </div>
</section>
