// Evidence for a recommendation: every search containing one of its
// matchTerms (all words of the term, as whole words).
function evidenceFor(item) {
  const terms = (item.matchTerms || []).filter(Boolean);
  if (!terms.length) return "";
  const quoted = terms.map(t => `“${escapeHtml(t)}”`).join(" or ");
  if (!GSC || !GSC.connected) {
    return `<div class="item-evidence"><strong>Your Google data:</strong> connect Search Console to see how often people search for ${quoted} and where you appear.</div>`;
  }
  const words = terms.map(t => t.toLowerCase().split(/\s+/).filter(Boolean));
  const matches = (GSC.queries || []).filter(q => {
    const qWords = new Set(q.query.toLowerCase().split(/[^a-z0-9]+/));
    return words.some(ws => ws.every(wd => qWords.has(wd)));
  });
  if (!matches.length) {
    return `<div class="item-evidence"><strong>Your Google data (last ${GSC.window.days} days):</strong> your site didn't appear for any search mentioning ${quoted}. You aren't visible for this topic yet.</div>`;
  }
  const impressions = matches.reduce((s, q) => s + q.impressions, 0);
  const clicks = matches.reduce((s, q) => s + q.clicks, 0);
  const best = Math.min(...matches.map(q => q.position));
  const top = matches.slice().sort((a, b) => b.impressions - a.impressions).slice(0, 3)
    .map(q => `“${escapeHtml(q.query)}” (#${Math.round(q.position)}, shown ${fmtNum(q.impressions)}×)`).join("; ");
  return `<div class="item-evidence"><strong>Your Google data (last ${GSC.window.days} days):</strong> searches mentioning ${quoted} showed your site ${fmtNum(impressions)} times, with ${fmtNum(clicks)} clicks. Best position #${Math.round(best)}. Top searches: ${top}.</div>`;
}

// ---------- recommendations ----------

async function loadDecisions() {
  try {
    const res = await fetch(API_STATE);
    if (!res.ok) throw new Error("HTTP " + res.status);
    const data = await res.json();
    decisions = (data && data.decisions) || {};
    setSync("Synced", false);
  } catch (e) {
    setSync("Offline — changes kept locally", true);
    try {
      const cached = localStorage.getItem("audit.decisions.cache");
      if (cached) decisions = JSON.parse(cached);
    } catch (_) { /* storage unavailable */ }
  }
  render();
}

async function saveDecision(n) {
  dirty.add(n);
  try { localStorage.setItem("audit.decisions.cache", JSON.stringify(decisions)); } catch (_) { /* storage unavailable */ }
  try {
    const res = await fetch(API_STATE, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ n: Number(n), decision: decisions[n] || null })
    });
    if (!res.ok) throw new Error("HTTP " + res.status);
    dirty.delete(n);
    if (dirty.size === 0) setSync("Synced", false);
  } catch (e) {
    setSync("Offline — " + dirty.size + " change(s) not synced", true);
  }
}

function setStatus(n, status) {
  decisions[n] = decisions[n] || {};
  if (decisions[n].status === status) delete decisions[n].status;
  else decisions[n].status = status;
  decisions[n].updatedAt = new Date().toISOString();
  if (!decisions[n].status && !decisions[n].note) delete decisions[n];
  saveDecision(n);
  render();
}

function setNote(n, note) {
  decisions[n] = decisions[n] || {};
  decisions[n].note = note;
  decisions[n].updatedAt = new Date().toISOString();
  if (!decisions[n].status && !decisions[n].note) delete decisions[n];
  saveDecision(n);
}

function setSync(msg, isError) {
  const el = document.getElementById("sync-status");
  el.textContent = msg;
  el.classList.toggle("error", !!isError);
}

function isNew(item) {
  if (!item.firstSeen) return false;
  return Date.now() - new Date(item.firstSeen).getTime() < SEVEN_DAYS_MS;
}

function trustHtml(item) {
  const pills = [];
  if (item.owner && OWNERS[item.owner]) pills.push(`<span class="pill owner-${item.owner}">${OWNERS[item.owner]}${item.reviewer ? `: ${escapeHtml(item.reviewer)}` : ""}</span>`);
  if (item.confidence && CONFIDENCE[item.confidence]) pills.push(`<span class="pill confidence">${CONFIDENCE[item.confidence]}</span>`);
  return pills.length ? `<div class="trust">${pills.join("")}</div>` : "";
}

function render() {
  const ownerFilter = document.getElementById("filter-owner").value;
  const tierFilter = document.getElementById("filter-tier").value;
  const statusFilter = document.getElementById("filter-status").value;
  const list = document.getElementById("items");
  list.innerHTML = "";

  for (const item of ITEMS) {
    if (ownerFilter !== "all" && item.owner !== ownerFilter) continue;
    if (tierFilter !== "all" && String(item.tier) !== tierFilter) continue;
    const s = decisions[item.n] && decisions[item.n].status;
    if (statusFilter === "pending" && s) continue;
    if (statusFilter !== "all" && statusFilter !== "pending" && s !== statusFilter) continue;

    const el = document.createElement("article");
    el.id = `item-${item.n}`;
    el.className = "item" + (s ? " status-" + s : "") + (isNew(item) ? " is-new" : "");
    el.dataset.hasStatus = s ? "true" : "false";
    const shipit = (decisions[item.n] && decisions[item.n].shipit) || null;
    if (shipit && shipit.status) el.dataset.shipit = shipit.status;
    // "Needs you" items are done outside the website, so there's nothing to ship.
    const shipitButton = s === "approve" && item.owner !== "you" ? buildShipitButton(item.n, shipit) : "";

    el.innerHTML = `
      <div class="item-head">
        <div class="item-title"><span class="num">#${item.n}</span>${escapeHtml(item.title)}</div>
        <div class="item-badges">
          <span class="badge tier-${item.tier}">Tier ${item.tier}</span>
          <span class="badge impact-${item.impact}">Impact ${item.impact}</span>
          <span class="badge effort">Effort ${item.effort}</span>
        </div>
      </div>
      ${trustHtml(item)}
      ${item.why ? `<p class="item-why"><strong>Why we think this works:</strong> ${escapeHtml(item.why)}</p>` : ""}
      ${evidenceFor(item)}
      <details class="more"><summary>Full details</summary>
        <p class="item-body">${escapeHtml(item.body)}</p>
        <div class="item-files">Files: ${(item.files || []).map(f => `<code>${escapeHtml(f)}</code>`).join("")}</div>
        ${(item.addresses || []).length ? `<div class="item-files">Addresses gaps: ${item.addresses.map(escapeHtml).join(", ")}</div>` : ""}
      </details>
      <div class="actions">
        <button class="btn-approve" data-n="${item.n}" data-status="approve">✓ Approve</button>
        <button class="btn-park"    data-n="${item.n}" data-status="park">⏸ Park</button>
        <button class="btn-dismiss" data-n="${item.n}" data-status="dismiss">✕ Dismiss</button>
        ${shipitButton}
      </div>
      <textarea class="note-field" data-n="${item.n}" placeholder="Notes (why, when, who owns it…)">${escapeHtml((decisions[item.n] && decisions[item.n].note) || "")}</textarea>
    `;
    list.appendChild(el);
  }
  if (!list.children.length) list.innerHTML = `<p class="sv-empty">Nothing matches these filters.</p>`;

  list.querySelectorAll(".actions button:not(.btn-shipit)").forEach(btn => {
    btn.addEventListener("click", () => setStatus(Number(btn.dataset.n), btn.dataset.status));
  });
  list.querySelectorAll(".btn-shipit").forEach(btn => {
    btn.addEventListener("click", () => shipIt(Number(btn.dataset.n)));
  });
  list.querySelectorAll(".note-field").forEach(ta => {
    ta.addEventListener("blur", () => setNote(Number(ta.dataset.n), ta.value));
  });
  updateCounts();
}

function updateCounts() {
  const counts = { approve: 0, park: 0, dismiss: 0, pending: 0 };
  for (const item of ITEMS) {
    const s = (decisions[item.n] && decisions[item.n].status) || "pending";
    counts[s]++;
  }
  const html = `
    <span><span class="dot approve"></span><strong>${counts.approve}</strong> approved</span>
    <span><span class="dot park"></span><strong>${counts.park}</strong> parked</span>
    <span><span class="dot dismiss"></span><strong>${counts.dismiss}</strong> dismissed</span>
    <span><span class="dot pending"></span><strong>${counts.pending}</strong> pending</span>
  `;
  document.getElementById("toolbar-counts").innerHTML = html;
  document.getElementById("footer-counts").innerHTML = html;
}

// ---------- estimated rankings ----------

function svRankBadge(rank) {
  if (rank == null) return `<span class="sv-rank sv-rank-unknown">—</span>`;
  if (rank === 0 || rank > 10) return `<span class="sv-rank sv-rank-miss">not top 10</span>`;
  if (rank <= 3) return `<span class="sv-rank sv-rank-top">#${rank}</span>`;
  return `<span class="sv-rank sv-rank-mid">#${rank}</span>`;
}

function renderSearchVisibility() {
  const summary = document.getElementById("sv-summary");
  const list = document.getElementById("sv-list");
  if (!QUERY_POOL.length) {
    list.innerHTML = `<p class="sv-empty">No searches in the spot-check yet.</p>`;
    return;
  }
  const checked = QUERY_POOL.filter(q => q.lastResult);
  const inTop = max => checked.filter(q => q.lastResult.meridianRank > 0 && q.lastResult.meridianRank <= max).length;
  const top3 = inTop(3), top10 = inTop(10);
  document.getElementById("sv-summary-line").textContent =
    `Show the spot-check: ${top10} of ${checked.length} searches in the top 10 (estimate)`;
  summary.innerHTML = `
    <div class="sv-stats">
      <span><strong>${top3}</strong> in top 3</span>
      <span><strong>${top10}</strong> in top 10</span>
      <span><strong>${checked.length - top10}</strong> not in top 10</span>
      <span class="muted">${QUERY_POOL.filter(q => q.core).length} always checked · ${QUERY_POOL.length} tracked</span>
    </div>`;

  const sorted = [...QUERY_POOL].sort((a, b) => {
    if (!!b.core !== !!a.core) return b.core ? 1 : -1;
    const aRank = (a.lastResult && a.lastResult.meridianRank) || 999;
    const bRank = (b.lastResult && b.lastResult.meridianRank) || 999;
    if (aRank !== bRank) return aRank - bRank;
    return (b.priority || 0) - (a.priority || 0);
  });
  list.innerHTML = sorted.map(q => {
    const r = q.lastResult || {};
    const topDomain = (r.topDomains && r.topDomains[0]) || "";
    const checkedOn = r.date ? `checked ${escapeHtml(r.date)}` : "not checked yet";
    return `
      <div class="sv-item">
        <div class="sv-q">
          ${svRankBadge(r.meridianRank)}
          <span class="sv-query">${escapeHtml(q.q)}</span>
          ${q.core ? `<span class="sv-core">Always checked</span>` : ""}
          <span class="muted" style="font-size:0.78rem;">${checkedOn}</span>
        </div>
        ${topDomain || r.notes ? `<div class="sv-detail">${topDomain ? `Top: <code>${escapeHtml(topDomain)}</code>` : ""} ${r.notes ? `<span class="sv-notes">${escapeHtml(r.notes)}</span>` : ""}</div>` : ""}
      </div>`;
  }).join("");
}

// ---------- ship it ----------

function buildShipitButton(n, shipit) {
  if (!shipit || !shipit.status) {
    return `<button class="btn-shipit" data-n="${n}">🚀 Ship it</button>`;
  }
  const link = shipit.sessionUrl ? ` <span class="shipit-link"><a href="${escapeHtml(shipit.sessionUrl)}" target="_blank" rel="noopener">session</a></span>` : "";
  if (shipit.status === "shipping") {
    return `<button class="btn-shipit" data-n="${n}" disabled>Shipping…</button>${link}`;
  }
  if (shipit.status === "shipped") {
    return `<button class="btn-shipit" data-n="${n}">Ship again</button><span class="shipit-link">Draft PR requested ✓</span>${link}`;
  }
  if (shipit.status === "error") {
    return `<button class="btn-shipit" data-n="${n}">Retry ship</button><span class="shipit-link" style="color:var(--status-dismiss);">Error: ${escapeHtml(shipit.error || "unknown")}</span>`;
  }
  return `<button class="btn-shipit" data-n="${n}">🚀 Ship it</button>`;
}

async function shipIt(n) {
  const item = ITEMS.find(i => i.n === n);
  if (!item) return;
  const review = item.owner === "practitioner"
    ? `\n\nThe draft will need review by ${item.reviewer || "a practitioner"} before it goes live.`
    : "";
  if (!confirm(`Ship #${n} "${item.title}"?\n\nThis triggers a Claude routine that will implement this item and open a draft PR.${review}`)) return;

  decisions[n] = decisions[n] || {};
  decisions[n].shipit = { status: "shipping", startedAt: new Date().toISOString() };
  saveDecision(n);
  render();

  try {
    const res = await fetch(API_SHIPIT, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ item, note: (decisions[n] && decisions[n].note) || "" }),
    });
    const body = await res.json();
    if (!res.ok || !body.ok) {
      decisions[n].shipit = { status: "error", error: body.error || ("HTTP " + res.status), at: new Date().toISOString() };
      saveDecision(n);
      render();
      showToast(`Ship failed: ${body.error || res.status}`);
      return;
    }
    decisions[n].shipit = {
      status: "shipped",
      sessionId: body.sessionId || null,
      sessionUrl: body.sessionUrl || null,
      at: new Date().toISOString(),
    };
    saveDecision(n);
    render();
    showToast(`Shipping #${n} — check the session or your PRs in a few minutes`);
  } catch (e) {
    decisions[n].shipit = { status: "error", error: String(e), at: new Date().toISOString() };
    saveDecision(n);
    render();
    showToast(`Ship failed: ${e}`);
  }
}

function exportMarkdown() {
  const now = new Date().toISOString().slice(0, 10);
  const lines = [`# Audit decisions — ${now}`, ""];
  const byStatus = { approve: [], park: [], dismiss: [], pending: [] };
  for (const item of ITEMS) {
    const s = (decisions[item.n] && decisions[item.n].status) || "pending";
    byStatus[s].push(item);
  }
  for (const [status, label] of [["approve", "Approved — ship these"], ["park", "Parked — revisit later"], ["dismiss", "Dismissed — not doing"], ["pending", "Pending decision"]]) {
    if (!byStatus[status].length) continue;
    lines.push(`## ${label} (${byStatus[status].length})`, "");
    for (const item of byStatus[status]) {
      const note = decisions[item.n] && decisions[item.n].note;
      const who = item.owner && OWNERS[item.owner] ? `, ${OWNERS[item.owner]}${item.reviewer ? `: ${item.reviewer}` : ""}` : "";
      lines.push(`- **#${item.n} — ${item.title}** (Tier ${item.tier}, Impact ${item.impact}, Effort ${item.effort}${who})`);
      if (note) lines.push(`  - Note: ${note}`);
    }
    lines.push("");
  }
  const md = lines.join("\n");
  if (navigator.clipboard) navigator.clipboard.writeText(md).then(() => showToast("Decisions copied to clipboard as markdown")).catch(() => {});
  const blob = new Blob([md], { type: "text/markdown" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url; a.download = `audit-decisions-${now}.md`; a.click();
  URL.revokeObjectURL(url);
}

function showToast(msg) {
  const t = document.getElementById("toast");
  t.textContent = msg;
  t.classList.add("show");
  setTimeout(() => t.classList.remove("show"), 2200);
}

document.getElementById("filter-owner").addEventListener("change", render);
document.getElementById("filter-tier").addEventListener("change", render);
document.getElementById("filter-status").addEventListener("change", render);
document.getElementById("export").addEventListener("click", exportMarkdown);
document.getElementById("approve-tier1").addEventListener("click", () => {
  for (const item of ITEMS) if (item.tier === 1) {
    decisions[item.n] = decisions[item.n] || {};
    decisions[item.n].status = "approve";
    decisions[item.n].updatedAt = new Date().toISOString();
    saveDecision(item.n);
  }
  render();
  showToast("All Tier 1 items approved");
});
document.getElementById("reset").addEventListener("click", async () => {
  if (!confirm("Clear all statuses and notes? This cannot be undone.")) return;
  try {
    const res = await fetch(API_STATE, { method: "DELETE" });
    if (!res.ok) throw new Error("HTTP " + res.status);
    decisions = {};
    try { localStorage.removeItem("audit.decisions.cache"); } catch (_) { /* storage unavailable */ }
    render();
    showToast("Reset");
  } catch (e) {
    showToast("Reset failed — try again");
  }
});

renderStaleBanner();
renderTopActions();
renderGoogle();
renderSearchVisibility();
loadDecisions();
</script>
</body>
</html>
