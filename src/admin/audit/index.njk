---
permalink: /admin/audit/
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Search Audit — {{ auditConfig.site.name }}</title>
<link rel="icon" href="/images/logomark-dark.svg" type="image/svg+xml">
<link rel="stylesheet" href="/css/styles.css">
<style>
  /* Ink colours are the brand hues darkened until they pass WCAG AA (4.5:1)
     on their tinted backgrounds — the raw brand greens/golds don't. */
  :root {
    --status-approve: #3d663b;
    --status-approve-bg: #eaf3e9;
    --status-park: #8a6420;
    --status-park-bg: #faf1de;
    --status-dismiss: #9a3f58;
    --status-dismiss-bg: #f7e4ea;
    --neutral: #6a6a6a;
    --neutral-bg: #f4f4f5;
  }
  body { background: var(--lighter-bg); }
  .audit { max-width: 960px; margin: 0 auto; padding: 40px 16px 120px; }
  .audit-header { margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid var(--border); }
  .audit-header h1 { font-family: var(--font-secondary); font-size: 2rem; color: var(--text-dark); margin-bottom: 8px; font-weight: 400; }
  .audit-header .meta { color: var(--text-light); font-size: 0.9rem; }
  .audit-header .meta a, .muted a { color: var(--primary); text-decoration: underline; }
  .audit-header .sync { margin-top: 8px; font-size: 0.82rem; color: var(--text-light); }
  .audit-header .sync.error { color: var(--status-dismiss); }
  .banner { margin-top: 16px; padding: 12px 16px; border-radius: 8px; background: var(--status-dismiss-bg); color: var(--status-dismiss); font-size: 0.92rem; }
  .banner a { color: var(--status-dismiss); text-decoration: underline; }
  .muted { color: var(--text-light); font-size: 0.9rem; }

  .section-block { margin-bottom: 44px; }
  .section-block h2 { font-family: var(--font-secondary); font-weight: 400; font-size: 1.5rem; color: var(--text-dark); margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid var(--primary); display: inline-block; }
  .section-block h3 { font-size: 1.05rem; font-weight: 600; color: var(--text-dark); margin: 28px 0 6px; }
  .section-block > p, .section-block > ul { color: var(--text-body); margin-bottom: 12px; }
  .section-block ul.bullets { list-style: disc; padding-left: 24px; }
  .card { background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 20px; }

  /* This week */
  .summary { border-left: 3px solid var(--primary); }
  .summary p { margin-bottom: 8px; color: var(--text-body); }
  .summary p:last-child { margin-bottom: 0; }
  .actions-list { list-style: decimal; padding-left: 22px; margin-top: 16px; display: block; }
  .actions-list li { margin-bottom: 10px; color: var(--text-body); }
  .actions-list a { color: var(--primary); text-decoration: underline; }

  /* Google results */
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin: 12px 0 8px; }
  .tile { background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px; }
  .tile .label { font-size: 0.85rem; color: var(--text-light); line-height: 1.35; min-height: 2.4em; }
  .tile .value { font-size: 1.9rem; font-weight: 600; color: var(--text-dark); line-height: 1.2; margin-top: 4px; }
  .tile .delta { font-size: 0.82rem; margin-top: 2px; color: var(--text-light); }
  .delta.up { color: var(--status-approve); }
  .delta.down { color: var(--status-dismiss); }
  .charts { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; margin-top: 12px; }
  .chart { position: relative; }
  .chart h4 { font-size: 0.92rem; font-weight: 600; color: var(--text-dark); margin-bottom: 8px; }
  .chart svg { width: 100%; height: auto; display: block; overflow: visible; }
  .chart .axis { font-size: 10px; fill: var(--text-light); font-family: var(--font-primary); }
  .chart .grid { stroke: #e6e9ed; stroke-width: 1; }
  .chart .bar { fill: var(--primary); }
  .chart .bar.dim { opacity: 0.35; }
  .chart .end-label { font-size: 11px; font-weight: 600; fill: var(--text-dark); font-family: var(--font-primary); }
  .chart-tip { position: absolute; pointer-events: none; background: var(--text-dark); color: var(--white); font-size: 0.8rem; padding: 6px 10px; border-radius: 6px; white-space: nowrap; opacity: 0; transition: opacity .1s; transform: translate(-50%, -100%); z-index: 5; }
  .chart-tip.show { opacity: 1; }
  details.more { margin-top: 12px; }
  details.more > summary { cursor: pointer; color: var(--primary); font-size: 0.9rem; font-weight: 500; }
  .table-wrap { overflow-x: auto; margin-top: 8px; background: var(--white); border: 1px solid var(--border); border-radius: 8px; }
  table.data { width: 100%; min-width: 560px; border-collapse: collapse; font-size: 0.88rem; }
  table.data th, table.data td { padding: 8px 12px; text-align: left; border-bottom: 1px solid #eef1f4; vertical-align: top; }
  table.data th { font-weight: 600; color: var(--text-dark); background: var(--neutral-bg); white-space: nowrap; }
  table.data td.num, table.data th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  table.data tr:last-child td { border-bottom: 0; }
  table.data code { font-size: 0.8rem; color: var(--text-light); overflow-wrap: anywhere; }
  .setup { border-left: 3px solid var(--status-park); }
  .setup .status { font-weight: 600; color: var(--text-dark); margin-bottom: 6px; }
  .setup a.button { display: inline-block; margin-top: 12px; background: var(--primary); color: var(--white); padding: 8px 16px; border-radius: 6px; text-decoration: none; font-weight: 500; }

  /* Recommendations */
  .toolbar { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin: 16px 0 24px; padding: 16px; background: var(--white); border: 1px solid var(--border); border-radius: 8px; }
  .toolbar .counts { display: flex; gap: 16px; flex: 1; min-width: 240px; flex-wrap: wrap; }
  .toolbar select, .toolbar button { font: inherit; font-size: 0.9rem; padding: 8px 14px; border: 1px solid var(--border); border-radius: 6px; background: var(--white); color: var(--text-dark); cursor: pointer; }
  .toolbar button:hover { background: var(--neutral-bg); }
  .toolbar .export-btn { background: var(--primary); color: var(--white); border-color: var(--primary); font-weight: 500; }
  .toolbar .export-btn:hover { background: var(--primary-dark); }
  .item { background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 20px; margin-bottom: 12px; transition: border-color .15s; position: relative; scroll-margin-top: 16px; }
  .item.status-approve { border-left: 4px solid var(--status-approve); }
  .item.status-park    { border-left: 4px solid var(--status-park); }
  .item.status-dismiss { border-left: 4px solid var(--status-dismiss); opacity: 0.72; }
  .item.is-new::before { content: "New"; position: absolute; top: -8px; right: 16px; background: var(--primary); color: var(--white); font-size: 0.7rem; font-weight: 600; padding: 3px 10px; border-radius: 999px; letter-spacing: 0.05em; }
  .item-head { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
  .item-title { font-weight: 600; font-size: 1.05rem; color: var(--text-dark); flex: 1; min-width: 240px; }
  .item-title .num { color: var(--text-light); margin-right: 8px; font-weight: 400; }
  .item-badges { display: flex; gap: 6px; flex-wrap: wrap; }
  .badge { font-size: 0.72rem; padding: 3px 8px; border-radius: 999px; font-weight: 500; letter-spacing: 0.02em; text-transform: uppercase; white-space: nowrap; }
  .badge.tier-1 { background: var(--status-approve-bg); color: var(--status-approve); }
  .badge.tier-2 { background: var(--status-park-bg); color: var(--status-park); }
  .badge.tier-3 { background: var(--neutral-bg); color: var(--text-body); }
  .badge.impact-H { background: var(--primary); color: var(--white); }
  .badge.impact-M { background: var(--light-sky-blue); color: var(--primary); }
  .badge.impact-L { background: var(--neutral-bg); color: var(--text-body); }
  .badge.effort { background: var(--neutral-bg); color: var(--text-body); }
  .trust { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 12px; }
  .pill { font-size: 0.8rem; padding: 3px 10px; border-radius: 999px; font-weight: 500; display: inline-block; max-width: 100%; }
  .pill.owner-claude { background: var(--status-approve-bg); color: var(--status-approve); }
  .pill.owner-practitioner { background: var(--status-dismiss-bg); color: var(--status-dismiss); }
  .pill.owner-you { background: var(--light-sky-blue); color: var(--primary); }
  .pill.confidence { background: var(--neutral-bg); color: var(--text-body); }
  .item-why, .item-evidence { margin-top: 10px; font-size: 0.9rem; color: var(--text-body); }
  .item-why strong, .item-evidence strong { color: var(--text-dark); }
  .item-evidence { background: var(--neutral-bg); border-radius: 6px; padding: 8px 12px; }
  .item-body { margin-top: 10px; color: var(--text-body); font-size: 0.92rem; }
  .item-files { margin-top: 10px; font-size: 0.82rem; color: var(--text-light); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .item-files code { background: var(--neutral-bg); padding: 2px 6px; border-radius: 4px; margin-right: 4px; display: inline-block; margin-bottom: 2px; }
  .item details.more > summary { font-size: 0.85rem; }
  .actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; align-items: center; }
  .actions button { font: inherit; font-size: 0.85rem; padding: 6px 14px; border: 1px solid var(--border); border-radius: 6px; background: var(--white); color: var(--text-dark); cursor: pointer; font-weight: 500; }
  .actions button:hover { background: var(--neutral-bg); }
  .actions button:disabled { opacity: 0.5; cursor: wait; }
  .item.status-approve .btn-approve { background: var(--status-approve); color: var(--white); border-color: var(--status-approve); }
  .item.status-park    .btn-park    { background: var(--status-park);    color: var(--white); border-color: var(--status-park); }
  .item.status-dismiss .btn-dismiss { background: var(--status-dismiss); color: var(--white); border-color: var(--status-dismiss); }
  .btn-shipit { background: var(--primary) !important; color: var(--white) !important; border-color: var(--primary) !important; font-weight: 600 !important; margin-left: auto; }
  .btn-shipit:hover { background: var(--primary-dark) !important; }
  .btn-shipit:disabled { background: var(--neutral) !important; border-color: var(--neutral) !important; cursor: wait; }
  .item[data-shipit="shipping"] .btn-shipit { background: var(--neutral) !important; border-color: var(--neutral) !important; }
  .item[data-shipit="shipped"] .btn-shipit { background: var(--status-approve) !important; border-color: var(--status-approve) !important; }
  .shipit-link { font-size: 0.78rem; color: var(--text-light); margin-left: 8px; }
  .shipit-link a { color: var(--primary); text-decoration: underline; }
  .note-field { width: 100%; margin-top: 10px; padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px; font: inherit; font-size: 0.9rem; color: var(--text-body); resize: vertical; min-height: 36px; font-family: inherit; display: none; }
  .item[data-has-status="true"] .note-field { display: block; }
  .sticky-footer { position: fixed; bottom: 0; left: 0; right: 0; background: var(--white); border-top: 1px solid var(--border); padding: 12px 16px; display: flex; gap: 12px; align-items: center; justify-content: center; flex-wrap: wrap; box-shadow: 0 -2px 8px rgba(0,0,0,.04); z-index: 10; }
  .counts { font-size: 0.88rem; color: var(--text-body); }
  .sticky-footer .counts { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; }
  .counts span { white-space: nowrap; }
  .dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 4px; vertical-align: middle; }
  .dot.approve { background: var(--status-approve); }
  .dot.park { background: var(--status-park); }
  .dot.dismiss { background: var(--status-dismiss); }
  .dot.pending { background: var(--neutral); }
  .toast { position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%); background: var(--text-dark); color: var(--white); padding: 10px 18px; border-radius: 6px; font-size: 0.88rem; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 20; }
  .toast.show { opacity: 1; }

  /* Background + estimated rankings */
  details.fold { background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 14px 18px; margin-bottom: 10px; }
  details.fold > summary { cursor: pointer; font-weight: 600; color: var(--text-dark); }
  details.fold[open] > summary { margin-bottom: 12px; }
  .tldr p { margin-bottom: 12px; font-size: 0.92rem; }
  .gap-item { padding: 10px 14px; border-left: 2px solid var(--border); margin-bottom: 10px; }
  .gap-item h4 { font-size: 0.95rem; color: var(--text-dark); margin-bottom: 4px; }
  .gap-item .why { color: var(--text-light); font-size: 0.85rem; }
  .sv-stats { display: flex; gap: 20px; flex-wrap: wrap; padding: 12px 16px; background: var(--neutral-bg); border-radius: 6px; font-size: 0.92rem; margin-bottom: 12px; }
  .sv-stats span strong { color: var(--primary); }
  .sv-empty { color: var(--text-light); font-style: italic; padding: 12px 0; }
  .sv-item { border: 1px solid var(--border); border-radius: 6px; padding: 10px 14px; margin-bottom: 6px; }
  .sv-q { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .sv-query { font-size: 0.92rem; color: var(--text-dark); flex: 1; min-width: 180px; }
  .sv-rank { font-size: 0.72rem; padding: 2px 8px; border-radius: 999px; font-weight: 600; letter-spacing: 0.02em; min-width: 72px; text-align: center; display: inline-block; }
  .sv-rank-top     { background: var(--status-approve); color: var(--white); }
  .sv-rank-mid     { background: var(--status-park);    color: var(--white); }
  .sv-rank-miss    { background: var(--status-dismiss); color: var(--white); }
  .sv-rank-unknown { background: var(--neutral-bg);     color: var(--text-body); }
  .sv-core { font-size: 0.72rem; padding: 2px 8px; border-radius: 999px; background: var(--light-sky-blue); color: var(--primary); font-weight: 600; }
  .sv-detail { margin-top: 6px; font-size: 0.82rem; color: var(--text-light); display: flex; gap: 12px; flex-wrap: wrap; }
  .sv-detail code { background: var(--neutral-bg); padding: 1px 6px; border-radius: 3px; }
  .sv-notes { font-style: italic; }
  .loading { text-align: center; color: var(--text-light); padding: 40px 0; font-size: 0.9rem; }
</style>
</head>
<body>
<main class="audit">
  <header class="audit-header">
    <h1>Search audit</h1>
    <div class="meta">
      Weekly report: <strong>{{ audit.meta.reportDate }}</strong> ·
      Google data: <strong>{% if gsc.connected %}{{ gsc.window.start }} → {{ gsc.window.end }}{% else %}not connected{% endif %}</strong> ·
      <a href="https://github.com/{{ auditConfig.site.repo }}/tree/main/reports">Past reports</a>
    </div>
    <div class="sync" id="sync-status">Loading decisions…</div>
    <div class="banner" id="stale-banner" hidden></div>
  </header>

  <section class="section-block" id="this-week">
    <h2>This week</h2>
    {%- if audit.summary and audit.summary.length %}
    <div class="card summary">
      {%- for p in audit.summary %}
      <p>{{ p }}</p>
      {%- endfor %}
      {%- if audit.topActions and audit.topActions.length %}
      <ol class="actions-list" id="top-actions"></ol>
      {%- endif %}
    </div>
    {%- else %}
    <p class="muted">No plain-English summary in this week's report yet. The detailed notes are under <a href="#background">Background &amp; history</a>.</p>
    {%- endif %}
  </section>

  <section class="section-block" id="google">
    <h2>Your Google results</h2>
    <div id="gsc-root"></div>
  </section>

  <section class="section-block" id="recommendations">
    <h2>Recommendations</h2>
    <p class="muted">Each one says who needs to act, how sure we are it will help, and — once Google is connected — what your own search data shows.</p>
    <div class="toolbar">
      <div class="counts" id="toolbar-counts"></div>
      <select id="filter-owner" aria-label="Filter by who acts">
        <option value="all">Everyone</option>
        <option value="claude">Claude can do this</option>
        <option value="practitioner">Needs practitioner review</option>
        <option value="you">Needs you</option>
      </select>
      <select id="filter-tier" aria-label="Filter by tier">
        <option value="all">All tiers</option>
        <option value="1">Tier 1 only</option>
        <option value="2">Tier 2 only</option>
        <option value="3">Tier 3 only</option>
      </select>
      <select id="filter-status" aria-label="Filter by status">
        <option value="all">All statuses</option>
        <option value="pending">Pending only</option>
        <option value="approve">Approved</option>
        <option value="park">Parked</option>
        <option value="dismiss">Dismissed</option>
      </select>
      <button id="approve-tier1">Approve all Tier&nbsp;1</button>
      <button id="reset">Reset all</button>
      <button class="export-btn" id="export">Export decisions</button>
    </div>
    <div id="items"><div class="loading">Loading recommendations…</div></div>
  </section>

  <section class="section-block" id="rankings">
    <h2>Estimated rankings</h2>
    <p class="muted">A weekly spot-check of important searches using Claude's web search. These are <strong>estimates</strong>: they aren't what someone in Christchurch sees on Google, and they don't include the Google Maps listings. When Google is connected, trust <a href="#google">Your Google results</a> first. Searches marked “Always checked” are never dropped from the list.
      {% if auditQueries.meta.lastRun %}Last checked <strong>{{ auditQueries.meta.lastRun }}</strong>.{% endif %}</p>
    <details class="fold">
      <summary id="sv-summary-line">Show the spot-check</summary>
      <div id="sv-summary"></div>
      <div id="sv-list"></div>
    </details>
  </section>

  <section class="section-block" id="background">
    <h2>Background &amp; history</h2>
    <details class="fold">
      <summary>Detailed notes from the latest weekly report</summary>
      <div class="tldr">
        {%- for p in audit.tldr %}
        <p>{{ p | safe }}</p>
        {%- endfor %}
      </div>
    </details>
    <details class="fold">
      <summary>Already done ({{ audit.alreadyShipped.length }})</summary>
      <ul class="bullets">
        {%- for s in audit.alreadyShipped %}
        <li>{{ s | safe }}</li>
        {%- endfor %}
      </ul>
    </details>
    <details class="fold">
      <summary>Known gaps ({{ audit.gaps.length }})</summary>
      {%- for g in audit.gaps %}
      <div class="gap-item">
        <h4>{{ g.id }}. {{ g.title }}</h4>
        <p class="why">{{ g.why }}</p>
      </div>
      {%- endfor %}
    </details>
  </section>

  <footer class="sticky-footer">
    <div class="counts" id="footer-counts"></div>
  </footer>
  <div id="toast" class="toast"></div>
</main>

<script>
const AUDIT = {{ audit | jsonScript | safe }};
const AUDIT_QUERIES = {{ auditQueries | jsonScript | safe }};
const GSC = {{ gsc | jsonScript | safe }};
const CONFIG = {{ auditConfig | jsonScript | safe }};
const ITEMS = AUDIT.items || [];
const QUERY_POOL = (AUDIT_QUERIES && AUDIT_QUERIES.pool) || [];
const API_STATE = "/.netlify/functions/audit-state";
const API_SHIPIT = "/.netlify/functions/audit-ship-it";
const SETUP_GUIDE = `https://github.com/${CONFIG.site.repo}/blob/main/docs/gsc-setup.md`;
const DAY_MS = 24 * 60 * 60 * 1000;
const SEVEN_DAYS_MS = 7 * DAY_MS;

const OWNERS = {
  claude: "Claude can do this",
  practitioner: "Needs practitioner review",
  you: "Needs you",
};
const CONFIDENCE = {
  proven: "Worked on your site before",
  likely: "Good evidence elsewhere",
  experimental: "Experiment: weak evidence",
};

let decisions = {};
let dirty = new Set();

// ---------- helpers ----------

function escapeHtml(s) {
  return String(s == null ? "" : s).replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c]));
}
const fmtNum = n => Number(n || 0).toLocaleString("en-NZ");
function fmtDate(iso) {
  return new Date(iso + "T00:00:00Z").toLocaleDateString("en-NZ", { day: "numeric", month: "short", timeZone: "UTC" });
}
function placeText(pos) {
  if (pos == null) return "—";
  const p = Math.max(1, Math.round(pos));
  const page = p <= 10 ? "page 1" : p <= 20 ? "page 2" : "page 3+";
  return `#${p} <span class="muted">(${page})</span>`;
}
// Change vs the previous period, coloured by whether the move is good.
function deltaHtml(cur, prev, { lowerIsBetter = false, unit = "" } = {}) {
  if (prev == null) return `<span class="delta">new this period</span>`;
  const diff = cur - prev;
  if (diff === 0) return `<span class="delta">no change</span>`;
  const good = lowerIsBetter ? diff < 0 : diff > 0;
  const arrow = diff > 0 ? "▲" : "▼";
  let text;
  if (unit === "places") {
    text = `${good ? "up" : "down"} ${Math.abs(diff).toFixed(1)} places`;
  } else if (prev > 0) {
    text = `${diff > 0 ? "+" : "−"}${Math.abs(Math.round((diff / prev) * 100))}%`;
  } else {
    text = `${diff > 0 ? "+" : "−"}${fmtNum(Math.abs(diff))}`;
  }
  return `<span class="delta ${good ? "up" : "down"}">${arrow} ${text}</span>`;
}

// ---------- header ----------

function renderStaleBanner() {
  const report = AUDIT.meta && AUDIT.meta.reportDate;
  if (!report) return;
  const ageDays = Math.floor((Date.now() - Date.parse(report + "T00:00:00Z")) / DAY_MS);
  const limit = (CONFIG.digest && CONFIG.digest.staleAfterDays) || 8;
  if (ageDays <= limit) return;
  const el = document.getElementById("stale-banner");
  el.innerHTML = `The weekly audit last ran on <strong>${escapeHtml(report)}</strong> (${ageDays} days ago), so this page may be out of date. Check the routine at <a href="https://claude.ai/code/routines" target="_blank" rel="noopener">claude.ai/code/routines</a>.`;
  el.hidden = false;
}

function renderTopActions() {
  const list = document.getElementById("top-actions");
  if (!list) return;
  list.innerHTML = (AUDIT.topActions || []).map(a => {
    const who = a.owner && OWNERS[a.owner] ? ` <span class="pill owner-${a.owner}">${OWNERS[a.owner]}</span>` : "";
    const link = a.n ? ` <a href="#item-${Number(a.n)}">See #${Number(a.n)}</a>` : "";
    return `<li>${escapeHtml(a.text)}${who}${link}</li>`;
  }).join("");
}

// ---------- Google results ----------

function niceMax(v) {
  if (v <= 0) return 1;
  const mag = Math.pow(10, Math.floor(Math.log10(v)));
  for (const m of [1, 2, 5, 10]) if (m * mag >= v) return m * mag;
  return 10 * mag;
}

// Single-series column chart: ≤24px columns, 4px rounded tops, 2px gaps,
// hairline grid, the latest week labelled, hover tooltip per column
// (wireChartTooltips). The weekly table under the charts is the text view.
function barChart(id, title, weeks, key) {
  const W = 480, H = 170, L = 40, R = 8, T = 18, B = 24;
  const values = weeks.map(w => w[key]);
  const max = niceMax(Math.max(...values));
  const slot = (W - L - R) / weeks.length;
  const bw = Math.min(24, slot - 2);
  const y = v => T + (H - T - B) * (1 - v / max);
  const ticks = [0, max / 2, max];
  let svg = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${escapeHtml(title)}">`;
  for (const t of ticks) {
    svg += `<line class="grid" x1="${L}" x2="${W - R}" y1="${y(t)}" y2="${y(t)}"/>`;
    svg += `<text class="axis" x="${L - 6}" y="${y(t) + 3}" text-anchor="end">${fmtNum(t)}</text>`;
  }
  weeks.forEach((w, i) => {
    const v = w[key];
    const x = L + i * slot + (slot - bw) / 2;
    const top = y(v), h = H - B - top;
    if (h > 0) {
      const r = Math.min(4, h, bw / 2);
      svg += `<path class="bar" d="M${x},${H - B} L${x},${top + r} Q${x},${top} ${x + r},${top} L${x + bw - r},${top} Q${x + bw},${top} ${x + bw},${top + r} L${x + bw},${H - B} Z"/>`;
    }
    svg += `<rect class="hit" x="${L + i * slot}" y="${T}" width="${slot}" height="${H - T - B}" fill="transparent" data-i="${i}"/>`;
  });
  const last = weeks.length - 1;
  svg += `<text class="end-label" x="${L + last * slot + slot / 2}" y="${y(values[last]) - 5}" text-anchor="middle">${fmtNum(values[last])}</text>`;
  for (const i of [0, Math.floor(last / 2), last]) {
    svg += `<text class="axis" x="${L + i * slot + slot / 2}" y="${H - 6}" text-anchor="middle">${fmtDate(weeks[i].start)}</text>`;
  }
  svg += `</svg>`;
  return `<div class="card chart" id="${id}"><h4>${escapeHtml(title)}</h4>${svg}<div class="chart-tip"></div></div>`;
}

function wireChartTooltips(weeks) {
  document.querySelectorAll("#gsc-root .chart").forEach(chart => {
    const tip = chart.querySelector(".chart-tip");
    const key = chart.id === "chart-clicks" ? "clicks" : "impressions";
    const unit = key === "clicks" ? "clicks" : "times shown";
    chart.querySelectorAll("rect.hit").forEach(rect => {
      rect.addEventListener("mousemove", e => {
        const w = weeks[Number(rect.dataset.i)];
        const box = chart.getBoundingClientRect();
        tip.textContent = `Week of ${fmtDate(w.start)}: ${fmtNum(w[key])} ${unit}`;
        tip.style.left = `${e.clientX - box.left}px`;
        tip.style.top = `${e.clientY - box.top - 8}px`;
        tip.classList.add("show");
        chart.querySelectorAll(".bar").forEach((b, j) => b.classList.toggle("dim", j !== Number(rect.dataset.i)));
      });
      rect.addEventListener("mouseleave", () => {
        tip.classList.remove("show");
        chart.querySelectorAll(".bar").forEach(b => b.classList.remove("dim"));
      });
    });
  });
}

